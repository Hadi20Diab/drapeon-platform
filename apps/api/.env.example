NODE_ENV=development
PORT=4000
API_PREFIX=api
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_refresh_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
THROTTLE_TTL=60
THROTTLE_LIMIT=120
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require&pgbouncer=true&connect_timeout=15
DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require&connect_timeout=15
GEMINI_API_KEY=change_me_gemini_key
GEMINI_MODEL=gemini-3-flash-preview
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_CONNECT_COUNTRY=US
STRIPE_PLATFORM_FEE_BPS=750
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/checkout
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/designers/dashboard?stripe=refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/designers/dashboard?stripe=return
