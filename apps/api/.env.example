NODE_ENV=development
PORT=4000
API_PREFIX=api
WEB_ORIGIN=http://localhost:5173,https://drapeon-platform.vercel.app
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_refresh_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
THROTTLE_TTL=60
THROTTLE_LIMIT=120
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require&pgbouncer=true&connect_timeout=15
DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require&connect_timeout=15
GEMINI_API_KEY=change_me_gemini_key
GEMINI_MODEL=gemini-3.1-flash-lite
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=company-knowledge
PINECONE_TEXT_FIELD=text
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_CONNECT_COUNTRY=US
STRIPE_SUBSCRIPTION_SUCCESS_URL=/designers/billing?status=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_SUBSCRIPTION_CANCEL_URL=/designers/billing?status=cancelled
STRIPE_BILLING_PORTAL_RETURN_URL=/designers/billing
BREVO_API_KEY=
CONTACT_TO_EMAIL=hello@yourdomain.com
CONTACT_FROM_EMAIL=no-reply@yourdomain.com
CONTACT_FROM_NAME=Drapeon Contact
MAILIDATOR_API_KEY=
MAILIDATOR_TIMEOUT_MS=4000
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=3600
