generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  DESIGNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DesignerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionInterval {
  MONTH
  YEAR
}

enum DesignerSubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum ProductCategory {
  SUIT
  DRESS
}

enum BodyShape {
  HOURGLASS
  PEAR
  APPLE
  RECTANGLE
  INVERTED_TRIANGLE
  ATHLETIC
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AvailabilityStatus {
  AVAILABLE
  RESERVED
  UNAVAILABLE
}

enum BookingType {
  FITTING
  RENTAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum RentalOrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  RETURNED
  COMPLETED
  CANCELLED
}

enum ConversationStatus {
  OPEN
  ARCHIVED
}

enum MessageSenderRole {
  USER
  DESIGNER
}

enum DesignerNotificationType {
  ORDER_CREATED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  APPOINTMENT_REQUEST
  APPOINTMENT_CANCELLED
  MESSAGE_RECEIVED
}

enum DeliveryStatus {
  PENDING
  APPROVED
  PACKING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AiSessionChannel {
  REST
  WS
}

enum AiMessageRole {
  USER
  AGENT
  TOOL
  SYSTEM
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  role              UserRole          @default(USER)
  status            UserStatus        @default(ACTIVE)
  isEmailVerified   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  profile           UserProfile?
  refreshTokens     RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  bookings          Booking[]
  rentalOrders      RentalOrder[]
  deliveryRequests  DeliveryRequest[]
  aiSessions        AiSession[]
  designerConversations DesignerConversation[]
  designerMessages  DesignerMessage[]
  adminAuditLogs    AdminAuditLog[]   @relation("AuditActor")
  designerProfile   Designer?         @relation("DesignerAccount")
  approvedDesigners Designer[]        @relation("DesignerApprovedBy")

  @@index([role, status])
}

model UserProfile {
  id           String           @id @default(uuid())
  userId       String           @unique
  firstName    String
  lastName     String
  phoneNumber  String?
  preferences  Json?
  dateOfBirth  DateTime?
  avatarUrl    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  measurements BodyMeasurement?
}

model BodyMeasurement {
  id         String      @id @default(uuid())
  profileId  String      @unique
  bodyShape  BodyShape?
  heightCm   Decimal?    @db.Decimal(5, 2)
  weightKg   Decimal?    @db.Decimal(5, 2)
  chestCm    Decimal?    @db.Decimal(5, 2)
  waistCm    Decimal?    @db.Decimal(5, 2)
  hipCm      Decimal?    @db.Decimal(5, 2)
  shoulderCm Decimal?    @db.Decimal(5, 2)
  inseamCm   Decimal?    @db.Decimal(5, 2)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Designer {
  id             String                 @id @default(uuid())
  userId         String                 @unique
  storeName      String
  slug           String                 @unique
  bio            String
  location       String?
  brandColor     String?
  websiteUrl     String?
  instagramUrl   String?
  tiktokUrl      String?
  stripeAccountId String?               @unique
  stripeOnboardingComplete Boolean      @default(false)
  stripeChargesEnabled Boolean          @default(false)
  stripePayoutsEnabled Boolean          @default(false)
  stripeDetailsSubmitted Boolean        @default(false)
  stripeAccountCreatedAt DateTime?
  approvalStatus DesignerApprovalStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation("DesignerAccount", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy     User?                  @relation("DesignerApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  products       Product[]
  bookings       Booking[]
  rentalOrders   RentalOrder[]
  deliveries     DeliveryRequest[]
  conversations  DesignerConversation[]
  notifications  DesignerNotification[]
  subscription   DesignerSubscription?

  @@index([approvalStatus])
  @@index([stripeAccountId])
}

model SubscriptionPlan {
  id              String                 @id @default(uuid())
  slug            String                 @unique
  name            String
  description     String
  stripePriceId   String                 @unique
  stripeProductId String?
  currency        String                 @default("USD")
  interval        SubscriptionInterval   @default(MONTH)
  amount          Decimal                @db.Decimal(10, 2)
  productLimit    Int
  featured        Boolean                @default(false)
  isActive        Boolean                @default(true)
  sortOrder       Int                    @default(0)
  notes           String?
  features        String[]               @default([])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  subscriptions   DesignerSubscription[]

  @@index([isActive, sortOrder])
}

model DesignerSubscription {
  id                    String                     @id @default(uuid())
  designerId            String                     @unique
  planId                String?
  status                DesignerSubscriptionStatus @default(INACTIVE)
  stripeCustomerId      String?                    @unique
  stripeSubscriptionId  String?                    @unique
  stripeCheckoutSessionId String?                  @unique
  productLimitSnapshot  Int?
  productsPublishedThisPeriod Int                  @default(0)
  usagePeriodStart      DateTime?
  usagePeriodEnd        DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean                    @default(false)
  subscribedAt          DateTime?
  canceledAt            DateTime?
  lastCheckoutAt        DateTime?
  lastSyncedAt          DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  designer              Designer                   @relation(fields: [designerId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan?          @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status, currentPeriodEnd])
  @@index([planId])
}

model Product {
  id                  String            @id @default(uuid())
  designerId          String
  category            ProductCategory
  title               String
  slug                String            @unique
  description         String
  rentalPrice         Decimal           @db.Decimal(10, 2)
  buyPrice            Decimal?          @db.Decimal(10, 2)
  securityDeposit     Decimal?          @db.Decimal(10, 2)
  currency            String            @default("USD")
  tags                String[]          @default([])
  bodyShapes          BodyShape[]       @default([])
  status              ProductStatus     @default(DRAFT)
  isDeliveryAvailable Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  designer            Designer          @relation(fields: [designerId], references: [id], onDelete: Cascade)
  images              ProductImage[]
  variants            ProductVariant[]
  bookings            Booking[]
  orderItems          RentalOrderItem[]
  deliveryRequests    DeliveryRequest[]

  @@index([designerId, status])
  @@index([category, status])
  @@index([rentalPrice])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id               String                @id @default(uuid())
  productId        String
  sku              String                @unique
  sizeLabel        String
  color            String
  stockTotal       Int
  stockReserved    Int                   @default(0)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  availability     ProductAvailability[]
  bookings         Booking[]
  rentalOrderItems RentalOrderItem[]

  @@unique([productId, sizeLabel, color])
  @@index([productId, isActive])
  @@index([color])
}

model ProductAvailability {
  id             String             @id @default(uuid())
  variantId      String
  date           DateTime           @db.Date
  status         AvailabilityStatus @default(AVAILABLE)
  availableUnits Int
  reservedUnits  Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  variant        ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, date])
  @@index([date, status])
}

model Booking {
  id                       String           @id @default(uuid())
  userId                   String
  designerId               String
  productId                String
  variantId                String?
  type                     BookingType      @default(FITTING)
  status                   BookingStatus    @default(PENDING)
  startsAt                 DateTime
  endsAt                   DateTime
  notes                    String?
  requiresDesignerApproval Boolean          @default(true)
  approvedAt               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  designer                 Designer         @relation(fields: [designerId], references: [id], onDelete: Cascade)
  product                  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant                  ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  deliveryRequest          DeliveryRequest?

  @@index([userId, startsAt])
  @@index([designerId, startsAt])
  @@index([productId, startsAt])
}

model RentalOrder {
  id              String            @id @default(uuid())
  userId          String
  designerId      String
  status          RentalOrderStatus @default(PENDING)
  rentalStartDate DateTime
  rentalEndDate   DateTime
  subtotalAmount  Decimal           @db.Decimal(10, 2)
  serviceFee      Decimal           @db.Decimal(10, 2)
  totalAmount     Decimal           @db.Decimal(10, 2)
  deliveryAddress String
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  designer        Designer          @relation(fields: [designerId], references: [id], onDelete: Cascade)
  items           RentalOrderItem[]
  deliveryRequest DeliveryRequest?

  @@index([userId, status])
  @@index([designerId, status])
}

model RentalOrderItem {
  id          String          @id @default(uuid())
  orderId     String
  productId   String
  variantId   String?
  quantity    Int             @default(1)
  rentalDays  Int
  unitPrice   Decimal         @db.Decimal(10, 2)
  lineTotal   Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())
  rentalOrder RentalOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model DeliveryRequest {
  id              String                  @id @default(uuid())
  userId          String
  designerId      String
  orderId         String?                 @unique
  bookingId       String?                 @unique
  productId       String?
  deliveryAddress String
  contactPhone    String?
  instructions    String?
  status          DeliveryStatus          @default(PENDING)
  requestedAt     DateTime                @default(now())
  scheduledFor    DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  designer        Designer                @relation(fields: [designerId], references: [id], onDelete: Cascade)
  order           RentalOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  booking         Booking?                @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  product         Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  trackingEvents  DeliveryTrackingEvent[]

  @@index([userId, status])
  @@index([designerId, status])
}

model DeliveryTrackingEvent {
  id                String          @id @default(uuid())
  deliveryRequestId String
  status            DeliveryStatus
  note              String?
  createdAt         DateTime        @default(now())
  deliveryRequest   DeliveryRequest @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)

  @@index([deliveryRequestId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AiSession {
  id              String           @id @default(uuid())
  userId          String?
  channel         AiSessionChannel
  contextSnapshot Json?
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages        AiMessage[]

  @@index([userId, startedAt])
}

model AiMessage {
  id         String        @id @default(uuid())
  sessionId  String
  role       AiMessageRole
  content    String
  toolName   String?
  toolInput  Json?
  toolOutput Json?
  createdAt  DateTime      @default(now())
  session    AiSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model CompanyKnowledgeEntry {
  id                String   @id @default(uuid())
  slug              String   @unique
  question          String
  answer            String
  category          String?
  tags              String[] @default([])
  isPublished       Boolean  @default(true)
  pineconeSyncedAt  DateTime?
  pineconeSyncError String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isPublished, updatedAt])
  @@index([category])
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  actorAdminId String
  action       String
  targetType   String
  targetId     String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actorAdmin   User     @relation("AuditActor", fields: [actorAdminId], references: [id], onDelete: Cascade)

  @@index([actorAdminId, createdAt])
  @@index([targetType, targetId])
}

model DesignerConversation {
  id          String             @id @default(uuid())
  designerId  String
  customerId  String
  subject     String
  status      ConversationStatus @default(OPEN)
  unreadForDesigner Int          @default(0)
  unreadForCustomer Int          @default(0)
  lastMessageAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  designer    Designer           @relation(fields: [designerId], references: [id], onDelete: Cascade)
  customer    User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages    DesignerMessage[]

  @@unique([designerId, customerId, subject])
  @@index([designerId, lastMessageAt])
  @@index([customerId, lastMessageAt])
}

model DesignerMessage {
  id             String               @id @default(uuid())
  conversationId String
  senderId       String
  senderRole     MessageSenderRole
  body           String
  readAt         DateTime?
  createdAt      DateTime             @default(now())
  conversation   DesignerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model DesignerNotification {
  id          String                   @id @default(uuid())
  designerId  String
  type        DesignerNotificationType
  title       String
  body        String
  targetUrl   String?
  readAt      DateTime?
  createdAt   DateTime                 @default(now())
  designer    Designer                 @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@index([designerId, readAt, createdAt])
}
