{
  "name": "drapeon-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-vendor suit and dress rental platform",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "postinstall": "pnpm -C apps/api run prisma:generate",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "api:reseed": "pnpm -C apps/api prisma:reseed",
    "format": "pnpm -r format"
  },
  "pnpm": {
    "overrides": {
      "undici": "6.21.2"
    }
  }
}
